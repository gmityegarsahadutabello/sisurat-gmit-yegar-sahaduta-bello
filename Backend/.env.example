# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/gmit-yegar

# Server Port
PORT=5000

# CORS (optional)
# If set, this origin is added to the allowed CORS origins list.
CORS_ORIGIN=https://sisurat-gmit-yegar-sahaduta-bello.vercel.app

# Google OAuth Configuration
# Get these credentials from: https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized JavaScript origins: http://localhost:5500, http://127.0.0.1:5500
# 5. Add authorized redirect URIs: http://localhost:5500, http://127.0.0.1:5500
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AWS S3 Configuration (if using file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_BUCKET_NAME=your-bucket-name
